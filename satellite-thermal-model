import scipy as sp
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

#hello world!

# initialise constants
sigma = 5.67e-8  # Stefan-Boltzmann constant W/m^2K^4
solar_constant = 1361  # W/m^2
albedo = 0.3  # average albedo of Earth
emissivity = 0.612  # avg emissivity
Gravitational_constant = 6.67430e-11  # m^3 kg^-1 s^-2
mass_of_earth = 5.972e24  # kg
threshold_low = 293  # K (20 C)
threshold_high = 323  # K (50 C)

# satellite geometry
height = 2.0
width = 3.7
depth = 1.7

# model parameters
mass = 3000  # kg
c = 900  # J/kgK

# coating properties
coatings = {
    'Polymide Nanofiber Films': {'alpha': 0.004, 'epsilon': 0.93},
    'Ta2O5, SiN, SiO2 Film': {'alpha': 0.110, 'epsilon': 0.750},
    'Hughson White Paint A276': {'alpha': 0.26, 'epsilon': 0.88},
    'Bare Polished Aluminum': {'alpha': 0.4, 'epsilon': 0.04}
}

altitude = 35786e3
earth_radius = 6371e3
year_seconds = 365.25 * 24 * 3600

orbital_radius = earth_radius + altitude
orbital_period = 2 * np.pi * np.sqrt(orbital_radius**3 / (Gravitational_constant * mass_of_earth))

time_orbit = np.linspace(0, orbital_period, 500)
time_year = np.linspace(0, year_seconds, 5000)


def eclipse_mask(t):
    # Sun-Earth GEOM angle variation due to tilt
    sun_declination = 23.44 * np.pi/180 * np.sin(2*np.pi * t / year_seconds)

    # GEO latitude = 0, so shadow only when declination near 0 (equinox)
    shadow_condition = np.abs(sun_declination) < (earth_radius / orbital_radius)

    # Compute local eclipse geometry each orbit
    eclipse_half_angle = np.arccos(earth_radius / orbital_radius / np.cos(sun_declination))
    eclipse_duration = 2 * eclipse_half_angle / (2*np.pi) * orbital_period 

    # Check phase within each orbit
    orbit_phase = t % orbital_period 
    eclipse_phase = orbit_phase < eclipse_duration

    return shadow_condition & eclipse_phase


sunlight_year = np.where(eclipse_mask(time_year), 0, 1)

# orbital angle model only computed on one orbit
theta_rad = np.pi/4 * np.sin(2 * np.pi * time_orbit / orbital_period)
A_presented_orbit = height * (np.abs(width * np.cos(theta_rad)) + np.abs(depth * np.sin(theta_rad)))

# tile presented area over full year
reps = int(np.ceil(len(time_year) / len(A_presented_orbit)))
A_presented = np.tile(A_presented_orbit, reps)[:len(time_year)]

# Earth radiation view factor
half_angle_earth = np.arcsin(earth_radius / orbital_radius)
A_earth_orbit = np.pi * (earth_radius**2) * (1 - np.cos(half_angle_earth))

A_earth = A_earth_orbit * sunlight_year  # zero during eclipse

def heat_balance(alpha, epsilon, time_array):
    dt = time_array[1] - time_array[0]
    T = np.zeros_like(time_array)
    T[0] = 401  # Initial temperature

    for i in range(1, len(time_array)):
        Q_solar = alpha * solar_constant * sunlight_year[i] * A_presented[i]
        Q_albedo = solar_constant * albedo * (A_earth[i] / (4 * np.pi * orbital_radius**2))
        Q_ir = epsilon * sigma * T[i-1]**4 * A_presented[i]

        net_Q = Q_solar + Q_albedo - Q_ir
        T[i] = T[i-1] + net_Q * dt / (mass * c)

    return T


results = {}

# Run simulation for each coating
for name, props in coatings.items():
    alpha = props['alpha']
    epsilon = props['epsilon']

    # Solve full-year temperatures
    T_year = heat_balance(alpha, epsilon, time_year)

    # Store full profile
    results[name] = {"T": T_year}

    # Find worst thermal swing
    day_duration = 86400
    n_points_day = int(day_duration / (time_year[1] - time_year[0])) 
    max_swing = 0 
    worst_start_idx = 0

    for i in range(len(time_year) - n_points_day):
        window = T_year[i:i+n_points_day]
        swing = np.max(window) - np.min(window) 
        if swing > max_swing:
            max_swing = swing
            worst_start_idx = i 

    results[name]["worst_start"] = worst_start_idx

#Plot full year
plt.figure(figsize=(12, 6))
for name, data in results.items():
    plt.plot(time_year / 86400, data["T"], label=name)

plt.axhline(threshold_low, linestyle='--', label='20°C Limit (293K)')
plt.axhline(threshold_high, linestyle='--', label='50°C Limit (323K)')
plt.xlabel("Time (days)")
plt.ylabel("Temperature (K)")
plt.title("Full-Year Temperature Profile for Each Coating")
plt.grid(True)
plt.legend()
plt.show()

# Plot worst eclipse day 
plt.figure(figsize=(12, 6))
for name, data in results.items():
    idx = data["worst_start"]
    hours = (time_year[idx:idx+n_points_day] - time_year[idx]) / 3600
    T_day = data["T"][idx:idx+n_points_day]
    plt.plot(hours, T_day, label=name)

plt.axhline(threshold_low, linestyle='--', label='20°C Limit (293K)')
plt.axhline(threshold_high, linestyle='--', label='50°C Limit (323K)')
plt.xlabel("Time of Day (hours)")
plt.ylabel("Temperature (K)")
plt.title("Worst-Case Daily Temperature Variation for Each Coating")
plt.grid(True)
plt.legend()
plt.xlim(0,24)
plt.show()
