import scipy as sp
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.interpolate import interp1d


# initialise constants
sigma = 5.67e-8  # Stefan-Boltzmann constant W/m^2K^4
solar_constant = 1361  # W/m^2
albedo = 0.3  # average albedo of Earth
emissivity = 0.612  # avg emissivity
Gravitational_constant = 6.67430e-11  # m^3 kg^-1 s^-2
mass_of_earth = 5.972e24  # kg
threshold_low = 293  # K (20 C)
threshold_high = 323  # K (50 C)

# satellite geometry
height = 2.0
width = 3.7
depth = 1.7

# model parameters
mass = 3000  # kg
c = 900  # J/kgK

# coating properties
coatings = {
    'Polymide Nanofiber Films': {'alpha': 0.004, 'epsilon': 0.93},
    'Ta2O5, SiN, SiO2 Film': {'alpha': 0.110, 'epsilon': 0.750},
    'Hughson White Paint A276': {'alpha': 0.26, 'epsilon': 0.88},
    'Bare Polished Aluminum': {'alpha': 0.4, 'epsilon': 0.04}
}

altitude = 35786e3
earth_radius = 6371e3
year_seconds = 365.25 * 24 * 3600

orbital_radius = earth_radius + altitude
orbital_period = 2 * np.pi * np.sqrt(orbital_radius**3 / (Gravitational_constant * mass_of_earth))

time_orbit = np.linspace(0, orbital_period, 500)
time_year = np.linspace(0, year_seconds, 5000)


def eclipse_mask(t):
    # Sun-Earth GEOM angle variation due to tilt
    sun_declination = 23.44 * np.pi/180 * np.sin(2*np.pi * t / year_seconds)

    # GEO latitude = 0, so shadow only when declination near 0 (equinox)
    shadow_condition = np.abs(sun_declination) < (earth_radius / orbital_radius)

    # Compute local eclipse geometry each orbit
    eclipse_half_angle = np.arccos(earth_radius / orbital_radius / np.cos(sun_declination))
    eclipse_duration = 2 * eclipse_half_angle / (2*np.pi) * orbital_period 

    # Check phase within each orbit
    orbit_phase = t % orbital_period 
    eclipse_phase = orbit_phase < eclipse_duration

    return shadow_condition & eclipse_phase


sunlight_year = np.where(eclipse_mask(time_year), 0, 1)

# orbital angle model only computed on one orbit
theta_rad = np.pi/4 * np.sin(2 * np.pi * time_orbit / orbital_period)
A_presented_orbit = height * (np.abs(width * np.cos(theta_rad)) + np.abs(depth * np.sin(theta_rad)))

# tile presented area over full year
reps = int(np.ceil(len(time_year) / len(A_presented_orbit)))
A_presented = np.tile(A_presented_orbit, reps)[:len(time_year)]

# Earth radiation view factor
half_angle_earth = np.arcsin(earth_radius / orbital_radius)
A_earth_orbit = np.pi * (earth_radius**2) * (1 - np.cos(half_angle_earth))

A_earth = A_earth_orbit * sunlight_year  # zero during eclipse



A_pres_interp = interp1d(time_year, A_presented, kind='linear', fill_value='extrapolate')
sunlight_interp = interp1d(time_year, sunlight_year, kind='nearest', fill_value='extrapolate')
A_earth_interp = interp1d(time_year, A_earth, kind='linear', fill_value='extrapolate')

def thermal_rhs(t, T, alpha, epsilon, heater_state):
    T = float(T)
    # instantaneous presented area and sunlight flag
    A_pres = float(A_pres_interp(t))
    is_sunlit = float(sunlight_interp(t))  # 0 or 1 (nearest interp)
    A_earth_local = float(A_earth_interp(t))

    # inputs (W)
    Q_solar = alpha * solar_constant * is_sunlit * A_pres         # direct solar
    Q_albedo = solar_constant * albedo * (A_earth_local / (4.0 * np.pi * orbital_radius**2))
    Q_ir_loss = epsilon * sigma * (T**4) * A_pres                # radiative loss from body

    heater_power = 28000  # W (adjustable)
    if T < threshold_low:
        heater_state = 1
    elif T > threshold_high:
        heater_state = 0

    Q_heater = heater_power * heater_state

    Q_net = Q_solar + Q_albedo + Q_heater - Q_ir_loss
    dTdt = Q_net / (mass * c)

    return dTdt, heater_state, Q_heater


def heat_balance_RK4_with_heater(alpha, epsilon, time_array, T_init=401):
    n = len(time_array)
    T = np.zeros(n)
    heater_state = np.zeros(n)
    heater_energy = np.zeros(n)

    T[0] = T_init
    heater_state[0] = 0  # start OFF

    for i in range(n - 1):
        t = time_array[i]
        h = time_array[i + 1] - time_array[i]

        # Compute the four RK4 slopes
        k1, h1_state, Qh1 = thermal_rhs(t, T[i], alpha, epsilon, heater_state[i])
        k2, h2_state, Qh2 = thermal_rhs(t + h/2, T[i] + h/2*k1, alpha, epsilon, h1_state)
        k3, h3_state, Qh3 = thermal_rhs(t + h/2, T[i] + h/2*k2, alpha, epsilon, h2_state)
        k4, h4_state, Qh4 = thermal_rhs(t + h, T[i] + h*k3, alpha, epsilon, h3_state)

        # Weighted slope
        slope = (k1 + 2*k2 + 2*k3 + k4) / 6.0
        T[i+1] = T[i] + h * slope

        # Use latest heater state (from final RK4 call)
        heater_state[i+1] = h4_state

        # Accumulate heater energy (W * s = J)
        heater_energy[i+1] = heater_energy[i] + Qh4 * h

    total_energy_kWh = heater_energy[-1] / 3.6e6
    return T, heater_state, total_energy_kWh


results = {}

for name, props in coatings.items():
    alpha = props['alpha']
    epsilon = props['epsilon']

    T_sol, heater_state, energy_used = heat_balance_RK4_with_heater(alpha, epsilon, time_year)
    results[name] = {"T": T_sol, "heater": heater_state, "energy_kWh": energy_used}

    print(f"{name}: Total heater energy = {energy_used:.2f} kWh/year")

for name, data in results.items():
    plt.figure(figsize=(10,5))
    plt.plot(time_year/86400, data["T"], label=f"{name} Temperature")
    plt.fill_between(time_year/86400, threshold_low, threshold_high, color='orange', alpha=0.2, label="Heater band")
    plt.xlabel("Time (days)")
    plt.ylabel("Temperature (K)")
    plt.title(f"Temperature Evolution with Heater - {name}")
    plt.legend()
    plt.grid(True)
    plt.show()

